{
  "name": "pony-tesla-connection-test",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "setup": "node backend/setup.mjs",
    "start": "node --env-file-if-exists=.env backend/server.mjs",
    "register": "node --env-file-if-exists=.env backend/register.mjs",
    "test": "node --test backend/*.test.mjs",
    "test:browser": "node --test --test-timeout=30000 tests/browser.test.mjs",
    "test:deployment": "node --env-file-if-exists=.env deploy/smoke.mjs",
    "test:live-browser": "node --env-file-if-exists=.env tests/live-browser.mjs",
    "test:history-flow": "node backend/demo-history.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.0"
  }
}
